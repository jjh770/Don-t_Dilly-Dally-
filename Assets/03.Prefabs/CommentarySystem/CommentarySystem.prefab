  m_Script: {fileID: 11500000, guid: c848fde5220dcd049a78e0c2ad901ae6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CommentaryPlaybackManager
  _audioSource: {fileID: 4918364566836233242}
  _ttsManager: {fileID: 3241995776377645875}
  _eventTypeClips:
  - EventType: 0
    ClipData:
    - Subtitle: "\uC218\uC220 \uC2DC\uAC04 \uB05D\uB0AC\uC5B4. \uC5EC\uAE30\uAE4C\uC9C0\uC57C."
      Clip: {fileID: 8300000, guid: a25b8008a8e3c8e45b14d274ade493a6, type: 3}
    - Subtitle: "\uC5EC\uAE30\uC11C \uC885\uB8CC\uC57C. \uC218\uC220 \uC2DC\uAC04\uC774
        \uB05D\uB0AC\uC5B4."
      Clip: {fileID: 8300000, guid: e6a25023e73e973499b46c8a235f6003, type: 3}
    - Subtitle: "\uC2DC\uAC04\uC774 \uBAA8\uC790\uB790\uC5B4. \uC218\uC220 \uC885\uB8CC\uB2E4."
      Clip: {fileID: 8300000, guid: 535764b0c5391e8419aee31b2e588eac, type: 3}
    - Subtitle: "\uC81C\uD55C \uC2DC\uAC04 \uB05D\uB0AC\uB2E4. \uC5EC\uAE30\uC11C
        \uB9C8\uBB34\uB9AC\uD574\uC57C \uD574."
      Clip: {fileID: 8300000, guid: efa613ce6423c4d428da46c96d8e90b6, type: 3}
    - Subtitle: "\uC774\uC81C \uC190 \uB5BC. \uC218\uC220 \uC2DC\uAC04 \uB05D\uB0AC\uC5B4."
      Clip: {fileID: 8300000, guid: 64c3928471bc0db4ca49ede69fe34591, type: 3}
  - EventType: 1
    ClipData:
    - Subtitle: "\uC548\uD0C0\uAE5D\uC9C0\uB9CC \uB05D\uC774\uC57C. \uD658\uC790\uB97C
        \uBABB \uC0B4\uB838\uC5B4."
      Clip: {fileID: 8300000, guid: e7a537b7677febf40ba0e6277f0d3859, type: 3}
    - Subtitle: "\uD658\uC790\uB97C \uB05D\uB0B4 \uC0B4\uB9AC\uC9C0 \uBABB\uD588\uC5B4."
      Clip: {fileID: 8300000, guid: 98c704246017789438548267ea69dc5a, type: 3}
  - EventType: 2
    ClipData:
    - Subtitle: "\uC88B\uC544, \uC774\uBC88 \uCC98\uCE58\uB294 \uC81C\uB300\uB85C
        \uB4E4\uC5B4\uAC14\uC5B4."
      Clip: {fileID: 8300000, guid: a712d4e145abbdf4f8fe95a2aea8868d, type: 3}
    - Subtitle: "\uADF8\uB798 \uC774\uAC70\uC57C. \uBC29\uAE08 \uC218\uC220 \uC88B\uC558\uC5B4."
      Clip: {fileID: 8300000, guid: acb1e4d05c592644eb9dc35bf8c6d8d2, type: 3}
    - Subtitle: "\uBC29\uAE08 \uC218\uC220 \uC88B\uC558\uC5B4. \uC0C1\uD0DC\uAC00
        \uB208\uC5D0 \uB744\uAC8C \uB098\uC544\uC84C\uC5B4"
      Clip: {fileID: 8300000, guid: a3251ba2f659a96419e57e3e245ae308, type: 3}
    - Subtitle: "\uC624\uCF00\uC774 \uC218\uC220 \uC131\uACF5\uC774\uC57C. \uD658\uC790
        \uC0C1\uD0DC\uAC00 \uC880 \uB098\uC544\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: 16dc09f212f9c714d8e4615b09402ab9, type: 3}
    - Subtitle: "\uC88B\uC558\uC5B4, \uC774\uBC88 \uC218\uC220\uC740 \uC81C\uB300\uB85C
        \uC131\uACF5\uD588\uC5B4."
      Clip: {fileID: 8300000, guid: 216fab2f64abd1a47bbf0557ea122708, type: 3}
    - Subtitle: "\uC218\uC220 \uC544\uC8FC \uC88B\uC558\uC5B4. \uB2E4\uC74C \uAC70
        \uC900\uBE44\uD574."
      Clip: {fileID: 8300000, guid: 79a2d1f0a691c25458b2f71fb1794451, type: 3}
    - Subtitle: "\uC218\uC220 \uC798 \uB4E4\uC5B4\uAC14\uC5B4. \uC9C0\uAE08 \uC0C1\uD0DC
        \uAF64 \uC548\uC815\uC801\uC774\uC57C."
      Clip: {fileID: 8300000, guid: 4df0ba05530e07a438625078c0b9802d, type: 3}
    - Subtitle: "\uD734, \uCC98\uCE58 \uC798 \uD588\uB2E4. \uC77C\uB2E8 \uD55C\uC228
        \uB3CC\uB9B4 \uC218 \uC788\uACA0\uC5B4."
      Clip: {fileID: 8300000, guid: f74d799c491be524b97842a06230601f, type: 3}
    - Subtitle: "\uBC29\uAE08 \uC218\uC220 \uB355\uBD84\uC5D0 \uC0C1\uD0DC\uAC00
        \uC880 \uD480\uB838\uC5B4."
      Clip: {fileID: 8300000, guid: 7403fa8003ca5b747b70b18134942aeb, type: 3}
  - EventType: 3
    ClipData:
    - Subtitle: "\uC218\uC220 \uC2E4\uD328\uC57C. \uC9C0\uAE08 \uC0C1\uD0DC\uAC00
        \uB354 \uC548 \uC88B\uC544\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: e8ca19e11718bbe4eab66062bccf7a84, type: 3}
    - Subtitle: "\uBC29\uAE08 \uCC98\uCE58 \uC5B4\uAE0B\uB0AC\uC5B4. \uD658\uC790
        \uCABD \uBC18\uC751\uC774 \uC548 \uC88B\uC544."
      Clip: {fileID: 8300000, guid: 34a8b623b2873f64597e5c768f0c3717, type: 3}
    - Subtitle: "\uC544\uB0D0, \uADF8 \uCC98\uCE58\uB294 \uD2C0\uB838\uC5B4. \uD658\uC790
        \uCCB4\uB825\uC774 \uB5A8\uC5B4\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: 0ccb8eb0630d8b545945e6301f1342bd, type: 3}
    - Subtitle: "\uC218\uC220 \uC2E4\uD328\uB2E4. \uC9C0\uAE08 \uBC14\uB85C \uC218\uC2B5\uD574\uC57C
        \uD574."
      Clip: {fileID: 8300000, guid: 07302d12251853148809a68d7f0458ab, type: 3}
  - EventType: 4
    ClipData:
    - Subtitle: "\uC9C0\uAE08 \uB108\uBB34 \uC9C0\uCCB4\uB418\uACE0 \uC788\uC5B4.
        \uBE68\uB9AC \uC218\uC220 \uB4E4\uC5B4\uAC00."
      Clip: {fileID: 8300000, guid: 327cae314adcd814b910c5548c804c4f, type: 3}
    - Subtitle: "\uC2DC\uAC04 \uB04C \uC5EC\uC720 \uC5C6\uC5B4. \uC9C0\uAE08 \uBC14\uB85C
        \uCE58\uB8CC\uD574."
      Clip: {fileID: 8300000, guid: ce05d18465d77dc45b49dbdc2024ba94, type: 3}
    - Subtitle: "\uC9C4\uD589\uC774 \uBA48\uCDC4\uC5B4. \uC9C0\uAE08 \uB2E4\uC2DC
        \uC218\uC220 \uC774\uC5B4\uAC00."
      Clip: {fileID: 8300000, guid: aa5f0e45a31edc24aad9fcdd9ef1ae85, type: 3}
    - Subtitle: "\uC774\uB300\uB85C \uC9C0\uC5F0\uB418\uBA74 \uC704\uD5D8\uD574.
        \uBE68\uB9AC \uB3C4\uAD6C \uC900\uBE44\uD574."
      Clip: {fileID: 8300000, guid: 816a3b373d70b464fbe5e0540e85c3b1, type: 3}
    - Subtitle: "\uBB50 \uD574, \uC218\uC220\uC774 \uC548 \uB4E4\uC5B4\uAC00\uACE0
        \uC788\uC796\uC544."
      Clip: {fileID: 8300000, guid: acb136e5a5f5d7647bdbb6d2aa775f5e, type: 3}
  - EventType: 5
    ClipData:
    - Subtitle: "\uC9C0\uAE08 \uC704\uD5D8\uD574. \uD658\uC790 \uCCB4\uB825\uC774
        \uAC70\uC758 \uBC14\uB2E5\uC774\uC57C."
      Clip: {fileID: 8300000, guid: 336787248310bbb49a333c570029b368, type: 3}
    - Subtitle: "\uCCB4\uB825\uC774 \uB9CE\uC774 \uB5A8\uC5B4\uC84C\uC5B4. \uC11C\uB458\uB7EC."
      Clip: {fileID: 8300000, guid: 5cfd7fba035c9444cbef651a9862c1d6, type: 3}
    - Subtitle: "\uD658\uC790\uAC00 \uBC84\uD2F0\uAE30 \uD798\uB4E4\uC5B4\uD558\uACE0
        \uC788\uC5B4. \uBC14\uB85C \uCC98\uCE58 \uB4E4\uC5B4\uAC00."
      Clip: {fileID: 8300000, guid: a5f0603e04f10e84b96e6a30865ebcac, type: 3}
  - EventType: 6
    ClipData:
    - Subtitle: "\uC704\uAE30 \uB118\uACBC\uC5B4. \uB2E4\uC2DC \uC218\uC220\uC5D0
        \uC9D1\uC911\uD558\uC790."
      Clip: {fileID: 8300000, guid: 745a70967d20dd04d85b0630bfbda59d, type: 3}
    - Subtitle: "\uAE34\uAE09 \uC0C1\uD669 \uC798 \uB9C9\uC544\uB0C8\uC5B4. \uB354
        \uCEE4\uC9C0\uAE30 \uC804\uC5D0 \uB05D\uB0C8\uB2E4."
      Clip: {fileID: 8300000, guid: a2dd54a7ce79fa94a8b3025bc1f74dfb, type: 3}
    - Subtitle: "\uC751\uAE09 \uB300\uC751 \uC88B\uC544. \uC0AC\uACE0\uB85C \uC548
        \uBC88\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: dbd0ca336f8993e4bbf3dd3c787c0848, type: 3}
    - Subtitle: "\uC751\uAE09 \uC0C1\uD669\uC774 \uAE54\uB054\uD558\uAC8C \uC815\uB9AC\uB410\uC5B4."
      Clip: {fileID: 8300000, guid: 029744a2e6097024cbbc324aeefa95df, type: 3}
  - EventType: 7
    ClipData:
    - Subtitle: "\uB300\uC751\uC774 \uB2A6\uC5C8\uB2E4. \uD658\uC790 \uC0C1\uD0DC\uAC00
        \uC545\uD654\uB410\uC5B4."
      Clip: {fileID: 8300000, guid: 32addc8aeeb19ba4898ac5cc09c833ab, type: 3}
    - Subtitle: "\uC751\uAE09 \uCC98\uCE58 \uC2E4\uD328\uB2E4. \uCCB4\uB825\uC774
        \uB354 \uB5A8\uC5B4\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: 7c12d21c0f9c3bb48a21fd4ce7b80ad6, type: 3}
    - Subtitle: "\uAE34\uAE09 \uB300\uC751\uC774 \uC5B4\uAE0B\uB0AC\uC5B4. \uC9C0\uAE08
        \uC704\uD5D8\uD574."
      Clip: {fileID: 8300000, guid: eac9bf3d198c3624aaf6883625a65097, type: 3}
  - EventType: 8
    ClipData:
    - Subtitle: "\uC544\uB0D0, \uC774 \uC7AC\uB8CC \uC544\uB2C8\uC57C. \uD658\uC790
        \uC0C1\uD0DC\uB9CC \uB354 \uB098\uBE60\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: 02e723e76d12e964f930330ea9fc7190, type: 3}
    - Subtitle: "\uC9C0\uAE08 \uD658\uC790\uD55C\uD14C \uD544\uC694\uD55C \uB3C4\uAD6C\uB294
        \uADF8\uAC8C \uC544\uB2C8\uC57C."
      Clip: {fileID: 8300000, guid: 4effcd89838eeef40953e162986eb7df, type: 3}
    - Subtitle: "\uD5F7\uAC08\uB838\uC5B4. \uC798\uBABB\uB41C \uC7AC\uB8CC \uB54C\uBB38\uC5D0
        \uC218\uC220\uC774 \uC5B4\uADF8\uB7EC\uC84C\uC5B4."
      Clip: {fileID: 8300000, guid: 512e5103db0b8914b88086ab601581fe, type: 3}
    - Subtitle: "\uD2C0\uB9B0 \uB3C4\uAD6C\uC57C. \uB2E4\uC2DC \uD655\uC778\uD558\uACE0
        \uC81C\uB300\uB85C \uAC00\uC838\uC640."
      Clip: {fileID: 8300000, guid: 08e717cdeb50417458c607686466d834, type: 3}
